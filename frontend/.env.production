# Frontend environment variables for PRODUCTION
# These will be injected at build time by Vercel / Render / etc.
# Set these in your deployment platform's dashboard.

# Replace with your actual deployed backend URL:
VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1
VITE_STREAM_URL=https://your-backend.onrender.com/stream

# Must match PIPELINE_SECRET set in Render env vars
VITE_PIPELINE_SECRET=your-secret-token-here
